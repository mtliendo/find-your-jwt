# Auth0 Regular Web Application (not SPA / not Native)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# 32-byte hex secret used to encrypt the session cookie
# Generate with: openssl rand -hex 32
AUTH0_SECRET=

# Local default. On Vercel previews you can omit this and the SDK
# will infer the host from the request.
APP_BASE_URL=http://localhost:3000
